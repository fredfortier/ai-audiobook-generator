from collections.abc import Iterator
from os import PathLike

class EpubItem:
    id: str
    file_name: str
    media_type: str
    def get_content(self, default: bytes | None = None) -> bytes | None: ...

class EpubHtml(EpubItem): ...
class EpubNav(EpubHtml): ...
class EpubNcx(EpubItem): ...

class EpubBook:
    spine: list[tuple[str, str]]
    version: str
    def get_items(self) -> Iterator[EpubItem]: ...
    def get_metadata(self, namespace: str, name: str) -> list[tuple[object, dict[str, str]]]: ...

def read_epub(name: str | PathLike[str], options: dict[str, object] | None = None) -> EpubBook: ...
